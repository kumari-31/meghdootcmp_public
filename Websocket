1. pip install channels==4.3.2 ,daphne==4.2.1, websocket-client==1.8.0
2. Add 'channels' to INSTALLED_APPS in settings.py
3. Add ASGI_APPLICATION = 'your_project_name.asgi.application' to settings.py
4. Create a file named asgi.py in your project directory with the following content:    
    import os
os.environ.setdefault("DJANGO_SETTINGS_MODULE", "Unified_Proect_Api.settings")
from django.core.asgi import get_asgi_application
from channels.routing import ProtocolTypeRouter, URLRouter
from channels.auth import AuthMiddlewareStack
from unifiedapiapp.routing import websocket_urlpatterns
application = ProtocolTypeRouter({
    "http": get_asgi_application(),
    "websocket": AuthMiddlewareStack(
        URLRouter(websocket_urlpatterns)
    ),
})
5. Add this in routing.pyfrom django.urls import re_path
from .pod_exec import PodExecConsumer

websocket_urlpatterns = [
    re_path(r"ws/pods/exec/$", PodExecConsumer.as_asgi()),
]
6.pip install gunicorn uvicorn
7.pip install 'uvicorn[standard]'
8.gunicorn -w 4 -k uvicorn.workers.UvicornWorker Unified_Proect_Api.asgi:application --bind 0.0.0.0:8000 --ws websockets